PW_BASE_URL=http://localhost:3000

# =============================================================
# ELEGÍ EXACTAMENTE UNA API (una sola línea PW_API_URL activa)
# =============================================================
PW_API_URL=http://localhost:3001/routes
#PW_API_URL=https://lalcec.3devsnet.com/api/routes

# Credenciales locales
